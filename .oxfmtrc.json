{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "printWidth": 80,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "front/src/types/graphql.ts",
    "api/lambda/graphql/types/generated/**",
    "api/graphql.schema.json",
    "**/generated/**",
    "**/*.yml",
    "**/*.yaml",
    "**/*.md",
    "cdk.out",
    "out"
  ],
  "sortImports": {
    "groups": [
      ["value-builtin", "type-builtin"],
      ["value-sibling", "value-parent", "type-sibling", "type-parent"],
      ["value-index", "type-index"],
      "unknown"
    ]
  }
}
