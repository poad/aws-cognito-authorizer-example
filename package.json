{
  "private": true,
  "type": "module",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-awscdk": "^1.0.3"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "lint-fix": "pnpm -r --if-present lint-fix",
    "format": "pnpm -r --if-present format",
    "format-check": "pnpm -r --if-present format-check",
    "build": "pnpm -r --if-present build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "npm": "use pnpm please!",
    "yarn": "use pnpm please!"
  }
}
